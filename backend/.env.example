# Obligatoire en production. Secret pour signer les JWT.
# Générer une valeur forte (ex: openssl rand -base64 32)
JWT_SECRET=

# Origine autorisée pour CORS (URL du frontend).
# En dev: http://localhost:8080
# En production: https://votre-domaine.com
CORS_ORIGIN=http://localhost:8080

# development | production
NODE_ENV=development

# Chemin du fichier SQLite (optionnel, défaut: data/devtoolbox.db)
# DB_PATH=./data/devtoolbox.db

# Port du serveur (optionnel, défaut: 1400)
# PORT=1400

# ============================================
# Email — SMTP (optionnel)
# ============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ============================================
# Email — Resend (optionnel, alternative à SMTP)
# ============================================
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=noreply@votre-domaine.com

# URL publique du frontend (liens e-mail, bookmarklet)
# FRONTEND_URL=http://localhost:8080
# VITE_APP_URL=http://localhost:8080

# ============================================
# Domain Hub (optionnel)
# ============================================
# Activer le module (comparateur, portefeuille, API /api/domains).
# Les clés registrar (Cloudflare, Hostinger, OVH) se configurent par utilisateur
# dans Mon compte → Domain Hub — elles ne sont plus lues depuis l'environnement.
# DOMAIN_HUB_ENABLED=false
# Taux USD→EUR pour le comparateur (défaut 0.92)
# DOMAIN_USD_EUR_RATE=0.92

