# ============================================
# DevToolbox — Variables Docker Compose
# Copier vers .env : cp .env.example .env
# ============================================

# Tag des images GHCR (latest ou version semver sans préfixe v)
IMAGE_TAG=latest

# Port exposé du frontend sur l'hôte
FRONTEND_PORT=14001

# ============================================
# Backend (obligatoire en production)
# ============================================
# Générer : openssl rand -base64 32
JWT_SECRET=

NODE_ENV=production
PORT=1400
DB_PATH=/app/data/devtoolbox.db

# URL publique du frontend (CORS + liens e-mail)
CORS_ORIGIN=http://localhost:14001
FRONTEND_URL=http://localhost:14001

# ============================================
# SMTP (optionnel)
# ============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ============================================
# Frontend Vite (développement local uniquement)
# ============================================
VITE_API_URL=
