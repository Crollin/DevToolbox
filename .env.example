# ============================================
# DevToolbox — Variables Docker Compose
# Copier vers .env : cp .env.example .env
# ============================================

# Tag des images GHCR (latest ou version semver sans préfixe v)
IMAGE_TAG=latest

# Port exposé du frontend sur l'hôte
FRONTEND_PORT=14001

# ============================================
# Backend (obligatoire en production)
# ============================================
# Générer : openssl rand -base64 32
JWT_SECRET=

NODE_ENV=production
PORT=1400
DB_PATH=/app/data/devtoolbox.db

# URL publique du frontend (CORS + liens e-mail)
CORS_ORIGIN=http://localhost:14001
FRONTEND_URL=http://localhost:14001

# ============================================
# SMTP (optionnel)
# ============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ============================================
# Resend (optionnel, alternative à SMTP)
# ============================================
# Fournisseur email : resend | smtp (auto par défaut : Resend si clé présente, sinon SMTP)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=noreply@votre-domaine.com

# ============================================
# Telegram (optionnel)
# ============================================
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ============================================
# Domain Hub (optionnel)
# ============================================
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# HOSTINGER_API_TOKEN=
# OVH_APP_KEY=
# OVH_APP_SECRET=
# OVH_CONSUMER_KEY=
# OVH_SUBSIDIARY=FR
# DOMAIN_USD_EUR_RATE=0.92
# QONTO_API_KEY=Bearer xxxxx
# QONTO_STAGING_TOKEN=
# QONTO_BASE_URL=https://thirdparty.qonto.com

# ============================================
# Frontend Vite (développement local uniquement)
# ============================================
VITE_API_URL=
# URL publique de l'app (bookmarklet KB) — dev: http://localhost:8080
VITE_APP_URL=http://localhost:8080
